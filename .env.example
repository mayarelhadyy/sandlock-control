# Documentation only; export values in Railway/the shell. Not automatically loaded.
SANDLOCK_RESERVATION_ORIGINS=https://sandlock-app.vercel.app
SANDLOCK_LOCAL_HTTP=0
SANDLOCK_COOKIE_PARTITIONED=1
SANDLOCK_TRUST_PROXY=1
SANDLOCK_HTTP_HOST=0.0.0.0
# Railway supplies PORT; do not override it.
SANDLOCK_INITIALIZE_STORAGE=0
SANDLOCK_RESERVATION_WORKER=1
# KEEP your EXISTING volume paths; examples below are placeholders, not migrations.
# SANDLOCK_RESERVATION_DB=/YOUR_EXISTING_VOLUME/your-existing.sqlite3
# SANDLOCK_WORKBOOK=/YOUR_EXISTING_VOLUME/your-existing.xlsx
# Retain existing private MQTT settings in Railway; never commit secrets.
# Local tests/review only: SANDLOCK_MQTT_ENABLED=0
# Production: retain the currently authorized MQTT configuration.
SANDLOCK_BROKER_HOST=
SANDLOCK_BROKER_USERNAME=
SANDLOCK_BROKER_PASSWORD=
# Local HTTP only: LOCAL_HTTP=1, TRUST_PROXY=0, MQTT_ENABLED=0,
# explicit loopback frontend origin and fresh test paths.

# Optional Web Push (history works while disabled). Never expose the private key.
SANDLOCK_PUSH_ENABLED=0
SANDLOCK_VAPID_PUBLIC_KEY=
SANDLOCK_VAPID_PRIVATE_KEY=
SANDLOCK_VAPID_SUBJECT=
# Generate once with manage_push_keys.py; copy values privately into Railway.
