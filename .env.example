# Example only: the application does not automatically load this file.
# Export these in your shell / hosting environment. Local review defaults:
SANDLOCK_MQTT_ENABLED=0
SANDLOCK_LOCAL_HTTP=1
SANDLOCK_HTTP_HOST=127.0.0.1
SANDLOCK_HTTP_PORT=5000
SANDLOCK_USER_APP=../SandLock_User_Final
SANDLOCK_RESERVATION_DB=data/SandLock_Reservations.sqlite3
SANDLOCK_WORKBOOK=data/SandLock_Dashboard_Database.xlsx
SANDLOCK_RESERVATION_WORKER=1
# Set to 1 only for the first intentional creation of a new SQLite store.
SANDLOCK_INITIALIZE_STORAGE=0
# Only if later explicitly configuring an authorized broker, supply private values:
SANDLOCK_BROKER_HOST=
SANDLOCK_BROKER_USERNAME=
SANDLOCK_BROKER_PASSWORD=
# HTTPS deployments must use SANDLOCK_LOCAL_HTTP=0 (secure cookies).
# Leave custom origins unset for the intended same-origin deployment.
